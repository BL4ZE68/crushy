{
  "expo": {
    "name": "CRUSHY Admin",
    "slug": "crushy-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "crushy-admin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.crushy.admin",
      "supportsTablet": true
    },
    "android": {
      "package": "com.crushy.admin"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ]
  }
}
