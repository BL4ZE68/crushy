    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "android:export": "expo export --platform android",
    "test": "tsc --ignoreConfig --target ES2022 --module Node16 --moduleResolution Node16 --strict --skipLibCheck --rootDir src --outDir node_modules/.cache/crushy-tests src/games/gameData.ts src/daily/content.ts src/music/recommendations.ts src/rewards/achievements.ts src/admin/validation.ts && node --test tests/*.test.cjs"
